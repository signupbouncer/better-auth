{
  "name": "@signupbouncer/better-auth",
  "version": "0.2.0",
  "license": "MIT",
  "exports": "./mod.ts",
  "imports": {
    "better-auth": "npm:better-auth@^1.7.0",
    "better-auth/api": "npm:better-auth@^1.7.0/api",
    "@std/assert": "jsr:@std/assert@^1.0.19",
    "@deno/dnt": "jsr:@deno/dnt@0.44.0"
  },
  "publish": {
    "include": ["mod.ts", "internal.ts", "README.md", "CHANGELOG.md", "LICENSE"]
  },
  "fmt": { "lineWidth": 120, "exclude": ["npm/", ".dnt/"] },
  "lint": { "rules": { "tags": ["recommended", "jsr"] }, "exclude": ["npm/", ".dnt/"] },
  "tasks": {
    "test": "deno test --allow-env=NODE_ENV,NODE_DISABLE_COLORS,TERM,TMUX,TF_BUILD,CI,TEAMCITY_VERSION,TERM_PROGRAM,COLORTERM,TEST,BETTER_AUTH_SECRETS,BETTER_AUTH_TELEMETRY_DEBUG,BETTER_AUTH_TELEMETRY_ENDPOINT,BETTER_AUTH_TRUSTED_ORIGINS,AGENT_NAME,APPVEYOR,BUILDKITE,CIRCLECI,DRONE,GITEA_ACTIONS,GITHUB_ACTIONS,GITLAB_CI,TRAVIS --allow-read=README.md test/",
    "check": "deno fmt --check && deno lint && deno check mod.ts test/ scripts/",
    "publish:check": "deno publish --dry-run",
    "npm:deps": "deno run --no-prompt --allow-read=deno.json --allow-write=npm scripts/npm_deps.ts && cd npm && deno install",
    "npm:build": "deno run --no-prompt --allow-read=.,$HOME/.cache/deno,$HOME/.npmrc --allow-write=npm,.dnt --allow-env=DENO_DIR,HOME,XDG_CACHE_HOME scripts/build_npm.ts",
    "build:npm": "deno task npm:deps && deno task npm:build"
  }
}
